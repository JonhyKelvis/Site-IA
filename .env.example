# ------------------------------------------------------------------
# MotionLab — variáveis de ambiente
# Copie este arquivo para ".env" (uso local) e/ou cadastre na Vercel
# em: Project → Settings → Environment Variables
# ------------------------------------------------------------------

# OBRIGATÓRIO — sua chave da fal.ai (https://fal.ai/dashboard/keys)
# Ela fica SOMENTE no servidor (nunca é enviada ao navegador).
FAL_KEY=coloque-sua-chave-aqui

# OPCIONAL — código de acesso para o site.
# Se preenchido, qualquer pessoa que abrir o site precisará digitar
# esse código antes de gerar vídeos (protege seus créditos).
# Deixe vazio para o site ficar aberto.
SITE_ACCESS_CODE=
